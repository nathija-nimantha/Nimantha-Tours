generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  description String
  shortDesc   String?
  price       Int
  duration    Int
  maxPeople   Int?       // Made optional
  difficulty  String     // Changed to String for flexibility ("Easy", "Moderate", etc.)
  category    String
  featured    Boolean    @default(false)
  images      String[]   // Array of image URLs
  image       String?    // Single main image path
  location    String
  coordinates Json?      // {lat, lng}
  startDates  DateTime[]
  highlights  String[]   // Array of highlights
  rating      Float?     // Added rating field (can be calculated from reviews too)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  itinerary  Itinerary[]
  reviews    Review[]
  inclusions Inclusion[]
  exclusions Exclusion[]
  bookings   Booking[]

  @@map("tours")
}

model Itinerary {
  id            Int      @id @default(autoincrement())
  tourId        Int
  day           Int
  title         String
  description   String
  activities    String[]
  meals         String[] // breakfast, lunch, dinner
  accommodation String?

  // Relations
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("itineraries")
}

model Inclusion {
  id     Int    @id @default(autoincrement())
  tourId Int
  item   String

  // Relations
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("inclusions")
}

model Exclusion {
  id     Int    @id @default(autoincrement())
  tourId Int
  item   String

  // Relations
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("exclusions")
}

model Booking {
  id        Int    @id @default(autoincrement())
  bookingId String @unique // Custom booking ID like BK0001

  // Customer details
  title       String // Mr, Mrs, Ms, Dr, etc.
  name        String
  nationality String
  email       String
  phone       String

  startDate DateTime
  nights    Int
  adults    Int
  children  Int

  accommodation String
  specialNote   String?
  hearAboutUs   String?
  otherDetails  String?

  // System fields
  totalPrice Float         @default(0)
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  payment Payment?
  tour    Tour?    @relation(fields: [tourId], references: [id])
  tourId  Int?

  @@map("bookings")
}

model Payment {
  id        Int           @id @default(autoincrement())
  bookingId Int           @unique
  amount    Float
  status    PaymentStatus @default(PENDING)
  method    String?
  reference String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id     Int @id @default(autoincrement())
  tourId Int

  // Reviewer details
  name      String
  email     String
  rating    Int // 1-5 stars
  title     String?
  comment   String
  images    String[]
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tour Tour @relation(fields: [tourId], references: [id])

  @@map("reviews")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())

  @@map("categories")
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  country     String
  coordinates Json?
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("destinations")
}

model ContactInquiry {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("contact_inquiries")
}

model Newsletter {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  subscribed Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("newsletter_subscribers")
}

// Enums
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}